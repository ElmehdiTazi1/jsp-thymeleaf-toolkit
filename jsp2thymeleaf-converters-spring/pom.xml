<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>com.cybernostics</groupId>
    <artifactId>jsp2thymeleaf-converters-spring</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    
    <name>JSP2Thymeleaf Spring Converters</name>
    <description>Convertisseurs pour transformer les balises Spring MVC JSP en Thymeleaf</description>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <jsp2thymeleaf.version>1.0.0-SNAPSHOT</jsp2thymeleaf.version>
        <spring.version>5.2.0.RELEASE</spring.version>
    </properties>
    
    <dependencies>
        <!-- Dépendance sur l'API JSP2Thymeleaf -->
        <dependency>
            <groupId>com.cybernostics</groupId>
            <artifactId>jsp2thymeleaf-api</artifactId>
            <version>${jsp2thymeleaf.version}</version>
        </dependency>
        
        <!-- Dépendance sur le module principal JSP2Thymeleaf -->
        <dependency>
            <groupId>com.cybernostics</groupId>
            <artifactId>jsp2thymeleaf</artifactId>
            <version>${jsp2thymeleaf.version}</version>
        </dependency>
        
        <!-- Dépendances Spring -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        
        <!-- Dépendances pour les tests -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
