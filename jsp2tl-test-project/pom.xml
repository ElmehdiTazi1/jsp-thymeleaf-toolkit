<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">  
    <modelVersion>4.0.0</modelVersion>  
    <artifactId>jsp2tl-test-project</artifactId>  
    <version>1.0-SNAPSHOT</version>  
    <groupId>com.cybernostics.jsp2thymeleaf.test</groupId>  
    <packaging>jar</packaging>  
    <name>JSP2Thymeleaf Test Project</name>  
    <description>Simple JSP to Thymeleaf Conversion Test</description>  
    
    <!-- Add properties for Java module system access -->
    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <java.version>1.8</java.version>
        <argLine>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED</argLine>
    </properties>
    
    <build>
    <plugins>
        <!-- Maven compiler plugin with module system access -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.8.1</version>
            <configuration>
                <source>1.8</source>
                <target>1.8</target>
                <compilerArgs>
                    <arg>-parameters</arg>
                </compilerArgs>
            </configuration>
        </plugin>
        
        <!-- Maven surefire plugin with module system access -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>2.22.2</version>
            <configuration>
                <argLine>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED</argLine>
            </configuration>
        </plugin>
        
        <plugin>
            <groupId>com.cybernostics</groupId>
            <artifactId>jsp2tl-maven-plugin</artifactId>
            <version>1.0-SNAPSHOT</version>
            <executions>
                <execution>
                    <id>ConvertJSP2Thymeleaf</id>
                    <goals>
                        <goal>convert</goal>
                    </goals>
                    <configuration>
                        <taglibConverterPackages>com.cybernostics.jsp2thymeleaf.conveters.tld</taglibConverterPackages>
                        <outputDirectory>src/main/resources/templates</outputDirectory>
                        <srcDirectory>src/main/webapp/WEB-INF/jsp</srcDirectory>
                        <scriptletHandlingStrategy>HTML_COMMENT</scriptletHandlingStrategy>
                    </configuration>
                </execution>
            </executions>
            <dependencies>
                <!-- Ajoutez ici les dépendances vers les convertisseurs de taglibs si nécessaire -->
                <dependency>
                    <groupId>com.cybernostics</groupId>
                    <artifactId>jsp2thymeleaf-converters-spring-form</artifactId>
                    <version>1.0.0</version>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </plugin>
    </plugins>
</build>
</project>