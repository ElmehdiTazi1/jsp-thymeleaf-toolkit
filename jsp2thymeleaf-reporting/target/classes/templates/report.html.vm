<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JSP to Thymeleaf Conversion Report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { 
            padding: 20px; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .header { 
            margin-bottom: 30px;
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
        }
        .section { 
            margin-bottom: 30px; 
            padding: 20px;
            border-radius: 5px;
            background-color: #f8f9fa;
        }
        .summary-card {
            border-left: 4px solid #ccc;
            margin-bottom: 15px;
        }
        .summary-card.success { border-left-color: #28a745; }
        .summary-card.warning { border-left-color: #ffc107; }
        .summary-card.danger { border-left-color: #dc3545; }
        .tag-badge {
            margin-right: 5px;
            margin-bottom: 5px;
        }
        .issue-list {
            max-height: 400px;
            overflow-y: auto;
        }
        .file-list {
            max-height: 600px;
            overflow-y: auto;
        }
        .progress {
            height: 25px;
        }
        h1 { color: #343a40; }
        h2, h3 { color: #495057; }
        .card-header { 
            font-weight: 500; 
            background-color: rgba(0,0,0,.03);
        }
        .nav-tabs { margin-bottom: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1 class="display-4">JSP to Thymeleaf Conversion Report</h1>
            <p class="lead">Project: $report.projectName #if($report.projectVersion) (v$report.projectVersion) #end</p>
            <div class="row">
                <div class="col-md-6">
                    <p>
                        <strong>Report ID:</strong> $report.reportId<br>
                        <strong>Start Time:</strong> $report.startTime.format($dateFormatter)<br>
                        <strong>End Time:</strong> $report.endTime.format($dateFormatter)<br>
                        <strong>Duration:</strong> $helper.formatDuration($report.totalDuration.toMillis())<br>
                    </p>
                </div>
                <div class="col-md-6">
                    <p>
                        <strong>Converter Version:</strong> $report.converterVersion<br>
                        <strong>Files Processed:</strong> $report.totalFilesProcessed<br>
                        <strong>Conversion Success Rate:</strong> $String.format("%.2f", $conversionSuccessRate)%<br>
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Summary Section -->
        <div class="section">
            <h2>Conversion Summary</h2>
            
            <div class="row">
                <div class="col-md-4">
                    <div class="card summary-card success">
                        <div class="card-body">
                            <h5 class="card-title">Success</h5>
                            <p class="card-text">
                                <span class="display-5">$report.successfullyConverted</span><br>
                                Files fully converted
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card summary-card warning">
                        <div class="card-body">
                            <h5 class="card-title">Partial</h5>
                            <p class="card-text">
                                <span class="display-5">$report.partiallyConverted</span><br>
                                Files partially converted
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card summary-card danger">
                        <div class="card-body">
                            <h5 class="card-title">Failed</h5>
                            <p class="card-text">
                                <span class="display-5">$report.failedConversions</span><br>
                                Files failed to convert
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Progress Bar -->
            <div class="mt-4">
                <h5>Overall Conversion Progress</h5>
                <div class="progress">
                    #set($successPercent = ($report.successfullyConverted * 100) / $report.totalFilesProcessed)
                    #set($partialPercent = ($report.partiallyConverted * 100) / $report.totalFilesProcessed)
                    #set($failedPercent = ($report.failedConversions * 100) / $report.totalFilesProcessed)
                    
                    <div class="progress-bar bg-success" role="progressbar" style="width: ${successPercent}%" 
                         aria-valuenow="$successPercent" aria-valuemin="0" aria-valuemax="100">
                        #if($successPercent >= 10)$report.successfullyConverted#end
                    </div>
                    <div class="progress-bar bg-warning" role="progressbar" style="width: ${partialPercent}%" 
                         aria-valuenow="$partialPercent" aria-valuemin="0" aria-valuemax="100">
                        #if($partialPercent >= 10)$report.partiallyConverted#end
                    </div>
                    <div class="progress-bar bg-danger" role="progressbar" style="width: ${failedPercent}%" 
                         aria-valuenow="$failedPercent" aria-valuemin="0" aria-valuemax="100">
                        #if($failedPercent >= 10)$report.failedConversions#end
                    </div>
                </div>
                <div class="mt-2 text-muted small">
                    <span class="text-success">■</span> Successful ($String.format("%.1f", $successPercent)%) 
                    <span class="text-warning">■</span> Partial ($String.format("%.1f", $partialPercent)%) 
                    <span class="text-danger">■</span> Failed ($String.format("%.1f", $failedPercent)%)
                </div>
            </div>
            
            <!-- Issues Summary -->
            #if(!$report.issues.isEmpty())
            <div class="mt-4">
                <h5>Issues Summary</h5>
                <div class="row">
                    #if($issuesBySeverity.containsKey("CRITICAL"))
                    <div class="col-md-3">
                        <div class="alert alert-dark">
                            <strong>Critical:</strong> $issuesBySeverity.get("CRITICAL")
                        </div>
                    </div>
                    #end
                    
                    #if($issuesBySeverity.containsKey("ERROR"))
                    <div class="col-md-3">
                        <div class="alert alert-danger">
                            <strong>Errors:</strong> $issuesBySeverity.get("ERROR")
                        </div>
                    </div>
                    #end
                    
                    #if($issuesBySeverity.containsKey("WARNING"))
                    <div class="col-md-3">
                        <div class="alert alert-warning">
                            <strong>Warnings:</strong> $issuesBySeverity.get("WARNING")
                        </div>
                    </div>
                    #end
                    
                    #if($issuesBySeverity.containsKey("INFO"))
                    <div class="col-md-3">
                        <div class="alert alert-info">
                            <strong>Info:</strong> $issuesBySeverity.get("INFO")
                        </div>
                    </div>
                    #end
                </div>
            </div>
            #end
            
            <!-- Tag Statistics -->
            <div class="mt-4">
                <h5>Tag Conversion Statistics</h5>
                <div>
                    #foreach($entry in $report.tagConversionStatistics.entrySet())
                    <span class="badge bg-primary tag-badge">$entry.key: $entry.value</span>
                    #end
                </div>
            </div>
            
            <!-- Scriptlet Statistics -->
            <div class="mt-4">
                <h5>Scriptlet Statistics</h5>
                <div>
                    #foreach($entry in $report.scriptletStatistics.entrySet())
                    <span class="badge bg-secondary tag-badge">$entry.key: $entry.value</span>
                    #end
                </div>
            </div>
        </div>
        
        <!-- Tabs for detailed information -->
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="files-tab" data-bs-toggle="tab" data-bs-target="#files" 
                        type="button" role="tab" aria-controls="files" aria-selected="true">Files</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="issues-tab" data-bs-toggle="tab" data-bs-target="#issues" 
                        type="button" role="tab" aria-controls="issues" aria-selected="false">Issues</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="config-tab" data-bs-toggle="tab" data-bs-target="#config" 
                        type="button" role="tab" aria-controls="config" aria-selected="false">Configuration</button>
            </li>
        </ul>
        
        <div class="tab-content" id="myTabContent">
            <!-- Files Tab -->
            <div class="tab-pane fade show active" id="files" role="tabpanel" aria-labelledby="files-tab">
                <div class="file-list">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>File Path</th>
                                <th>Status</th>
                                <th>Duration</th>
                                <th>JSP Tags</th>
                                <th>Scriptlets</th>
                                <th>Issues</th>
                            </tr>
                        </thead>
                        <tbody>
                            #foreach($entry in $report.fileConversionSummaries.entrySet())
                            #set($summary = $entry.value)
                            <tr>
                                <td>$summary.filePath</td>
                                <td>
                                    <span class="badge bg-${helper.getStatusClass($summary.conversionStatus.name())}">
                                        $summary.conversionStatus
                                    </span>
                                </td>
                                <td>$helper.formatDuration($summary.processingDuration.toMillis())</td>
                                <td>$summary.convertedTags / $summary.totalJspTags</td>
                                <td>
                                    #if($summary.totalScriptlets > 0)
                                        $summary.convertedScriptlets / $summary.totalScriptlets
                                        #if($summary.commentedScriptlets > 0)
                                            ($summary.commentedScriptlets commented)
                                        #end
                                    #else
                                        -
                                    #end
                                </td>
                                <td>
                                    #if($summary.hasIssues())
                                        <span class="badge bg-warning">$summary.issues.size()</span>
                                    #else
                                        -
                                    #end
                                </td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Issues Tab -->
            <div class="tab-pane fade" id="issues" role="tabpanel" aria-labelledby="issues-tab">
                <div class="issue-list">
                    #if($report.issues.isEmpty())
                        <div class="alert alert-success">
                            <strong>Congratulations!</strong> No issues found during conversion.
                        </div>
                    #else
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>File</th>
                                    <th>Line</th>
                                    <th>Message</th>
                                    <th>Category</th>
                                </tr>
                            </thead>
                            <tbody>
                                #foreach($issue in $report.issues)
                                <tr>
                                    <td>
                                        <span class="badge bg-${helper.getSeverityClass($issue.severity.name())}">
                                            $issue.severity
                                        </span>
                                    </td>
                                    <td>$issue.filePath</td>
                                    <td>$issue.lineNumber</td>
                                    <td>$issue.message</td>
                                    <td>
                                        #if($issue.category)
                                            $issue.category
                                        #else
                                            -
                                        #end
                                    </td>
                                </tr>
                                #end
                            </tbody>
                        </table>
                    #end
                </div>
            </div>
            
            <!-- Configuration Tab -->
            <div class="tab-pane fade" id="config" role="tabpanel" aria-labelledby="config-tab">
                <div class="card">
                    <div class="card-header">
                        Converter Configuration
                    </div>
                    <div class="card-body">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Setting</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                #foreach($entry in $report.converterConfiguration.entrySet())
                                <tr>
                                    <td>$entry.key</td>
                                    <td>$entry.value</td>
                                </tr>
                                #end
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <footer class="mt-5 pt-4 border-top text-center text-muted">
            <p>Generated by JSP2Thymeleaf Converter v$report.converterVersion on $report.endTime.format($dateFormatter)</p>
        </footer>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>